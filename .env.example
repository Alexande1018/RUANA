FLASK_SECRET_KEY=change-this-to-a-long-random-value
RUANA_ADMIN_SESSION_EXPIRES=3600
RUANA_ALIADO_SESSION_EXPIRES=3600

# Credenciales de administrador (fuera del repositorio).
# Opción A: ruta a un JSON con hashes (recomendado en local/producción).
# RUANA_ADMIN_CREDENTIALS_PATH=.local-secrets/admin_credentials.json
# Opción B: JSON inline para Cloud Run u otros despliegues sin volumen.
# RUANA_ADMIN_CREDENTIALS_JSON={"version":1,"admins":{...}}
# Migración inicial desde admin_codes.json legado:
#   python RUANA/scripts/bootstrap_admin_credentials.py --legacy RUANA/config/admin_codes.json

FIREBASE_PROJECT_ID=ruana-4293f
GOOGLE_CLOUD_REGION=europe-west1
ARTIFACT_REGISTRY_REPOSITORY=ruana

SUPABASE_URL=https://qqlxgwbmtzcfrrobrfzy.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Prefer Supabase Transaction Pooler for Cloud Run/serverless.
# Example format:
# postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Local SQLite fallback while the Postgres adapter is being migrated.
RUANA_DB_PATH=./RUANA/ruana.db
